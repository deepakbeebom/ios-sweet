Subject: [PATCH] g0q: Galaxy S22+ (SM8450) hardware values

Measured with the boot shim on the phone (NOTES-g0q.md, boots 1-6):
- virtual timer PPI 11 = INTID 27; GICR frames 0x40000 apart (GICv4)
- splash framebuffer 0xb8000000, 1080x2340, stride 4320
- the Gunyah hypervisor traps EL1 CNTP_* accesses: do not touch the
  physical timer
- UFS: START STOP UNIT (Active) to the device W-LUN before any I/O
- SM7150-only drivers (keys, touch, USB) default off
---
diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index a1486081b..3bcddfbab 100644
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -125,7 +125,7 @@ keys_thread(void *arg, wait_result_t result)
 void
 sweet_keys_init(void)
 {
-	int enabled = 1;
+	int enabled = 0;	/* g0q: SM7150 PON/SPMI layout; S22+ driver not written yet */
 	thread_t thread;
 	if (keys_started) {
 		return;
diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 03defe6a7..12ef2bceb 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -638,7 +638,7 @@ out:
 void
 sweet_touch_init(void)
 {
-	int enabled = 1;
+	int enabled = 0;	/* g0q: Goodix on SM7150 QUP; the S22+ has STM FTS on SPI */
 	thread_t thread;
 	if (st.started) {
 		return;
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b926fe00..a9fdd3729 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -623,6 +623,21 @@ sweet_ufs_init(void)
 
 	lck_mtx_lock(&sweet_ufs_lock);
 	error = ufs_take_over_host();
+	if (!error) {
+		/*
+		 * g0q: the S22+ bootloader hands over with the UFS device in a low
+		 * power mode; every LUN answers NOT READY (sense 2/00/00) until a
+		 * START STOP UNIT with POWER CONDITION Active reaches the UFS Device
+		 * W-LUN (UPIU LUN 0xd0), as Linux's ufshcd does. Retries cover the
+		 * unit attention the first command may get.
+		 */
+		static const uint8_t ssu[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+		su.lun = 0xd0;
+		for (int i = 0; i < 3 && (error = ufs_scsi(ssu, sizeof(ssu), 0, false)); i++) {
+		}
+		su.lun = 0;
+		printf("SWEET UFS: START STOP UNIT (Active) to the device W-LUN: %d\n", error);
+	}
 	if (!error) {
 		static const uint8_t tur[6] = { 0x00 };
 		/* The first command after the bootloader may report a unit attention. */
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index b6c1a41ba..f377a99f2 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -76,7 +76,7 @@ usb_rd(vm_offset_t base, uint32_t off)
 void
 sweet_usb_probe(void)
 {
-	int enabled = 1;
+	int enabled = 0;	/* g0q: SM7150 GCC/QUSB2 registers; not ported yet */
 	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
 	bool clocks_on = true;
 
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
index 27bc49da9..1f1b1bfa0 100644
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -435,9 +435,9 @@ SweetHIDTouch::start(IOService *provider)
 	int native = 0;
 	PE_parse_boot_argn("sweetfb_native", &native, sizeof(native));
 	fLogicalW = native ? 1080 : 1125;
-	fLogicalH = native ? 2400 : 2436;
+	fLogicalH = native ? 2340 : 2436;	/* g0q panel 1080x2340 */
 	fOffX = (fLogicalW - 1080) / 2;
-	fOffY = (fLogicalH - 2400) / 2;
+	fOffY = (fLogicalH - 2340) / 2;
 	/* The digitizer covers the main display (backboardd maps it 1:1). */
 	setProperty("DisplayIntegrated", kOSBooleanTrue);
 	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb5684a..70ef1df91 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1843,7 +1843,7 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = 0xb8000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |	/* g0q */
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index e4c15f2bd..3253b4782 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -2273,8 +2273,10 @@ _enable_virtual_timer(void)
 	uint64_t cntvctl = CNTV_CTL_EL0_ENABLE; /* One wants to use 32 bits, but "mrs" prefers it this way */
 
 	__builtin_arm_wsr64("CNTV_CTL_EL0", cntvctl);
+#if !defined(SWEET)
 	/* disable the physical timer as a precaution, as its registers reset to architecturally unknown values */
 	__builtin_arm_wsr64("CNTP_CTL_EL0", CNTP_CTL_EL0_IMASKED);
+#endif /* g0q: the Gunyah hypervisor traps EL1 CNTP_* (undefined instruction, shim boot 2) */
 }
 
 void
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f83..82936215c 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,7 +515,7 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (0xb8000000 + 2308 * 4320)	/* g0q: 1080x2340 splash at 0xb8000000 */
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
@@ -686,7 +686,7 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, 0xb8000000	/* g0q cont_splash_region, 32MB aligned */
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 69289572d..43243e941 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,10 +11,10 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0xb8000000;	/* g0q */
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
-#define EARLY_HEIGHT 2400u
+#define EARLY_HEIGHT 2340u	/* g0q: S6E3FAB 1080x2340 */
 #define EARLY_STRIDE (4320u / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f49a..5b3de8105 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -47,12 +47,12 @@
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
  * (CNTV) is INTID 16 + 3 = 19.
  */
-#define SWEET_VTIMER_INTID        19
+#define SWEET_VTIMER_INTID        27      /* g0q (SM8450): PPI 11, measured on the phone */
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
 
-#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+#define GICR_PE_SIZE              0x40000 // g0q: GICv4 frames, DT redistributor-stride (boot 3)
 
 /* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
 #define GICD_CTLR                 0x0
